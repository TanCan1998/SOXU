{
  "name": "soxu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "icons:generate": "pnpm --filter @soxu/desktop icons:generate",
    "dev": "pnpm --filter @soxu/desktop dev",
    "tauri:dev": "pnpm --filter @soxu/desktop tauri dev",
    "tauri:build": "pnpm --filter @soxu/desktop tauri build",
    "check": "pnpm --filter @soxu/desktop check && node --test automation/loop/tests/*.test.mjs",
    "test:loop": "node --test automation/loop/tests/*.test.mjs",
    "agent:release": "node scripts/release.mjs",
    "mirror:atomgit": "node scripts/mirror.mjs",
    "agent": "node automation/loop/src/cli.mjs"
  }
}
