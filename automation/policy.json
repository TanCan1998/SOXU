{
  "schemaVersion": 1,
  "maxConcurrentAgents": 2,
  "maxRoundsPerInvocation": 5,
  "maxRetries": 1,
  "maxChangedFiles": 80,
  "maxChangedBytes": 1500000,
  "protectedPaths": [
    "AGENTS.md",
    "agents/policies/",
    "automation/policy.json",
    "automation/agent-models.json",
    ".github/workflows/",
    "scripts/release.mjs",
    "scripts/mirror.mjs",
    ".git/"
  ],
  "checks": [
    {
      "bin": "pnpm",
      "args": [
        "check"
      ],
      "timeoutMinutes": 8
    },
    {
      "bin": "pnpm",
      "args": [
        "--filter",
        "@soxu/desktop",
        "exec",
        "vite",
        "build"
      ],
      "timeoutMinutes": 5
    },
    {
      "bin": "cargo",
      "args": [
        "test",
        "--workspace"
      ],
      "timeoutMinutes": 12
    }
  ],
  "autoMerge": true,
  "autoRelease": false,
  "releaseChannel": "prerelease",
  "releaseBranch": "main",
  "integrationBranch": "dev",
  "mirrorMode": "atomgit-pull-preferred",
  "watchIntervalMinutes": 10,
  "maxContinuousHours": 8,
  "maxIssuesPerWatch": 12,
  "timeouts": {
    "piStartupSeconds": 90,
    "piIdleSeconds": 600,
    "idleExtensionSeconds": 600,
    "piHardMinutes": 35,
    "reviewHardMinutes": 12,
    "installMinutes": 6,
    "networkSeconds": 45,
    "shutdownGraceSeconds": 5
  },
  "recovery": {
    "manualOnQuota": true,
    "manualOnNetwork": true,
    "manualOnTimeout": true,
    "automaticApiRetries": 0,
    "preserveWorktree": true,
    "maxConflictFiles": 3,
    "maxConflictBlocks": 8
  },
  "taskTimeoutMinutes": 35,
  "reviewTimeoutMinutes": 8,
  "rpcIdleTimeoutMinutes": 8,
  "installTimeoutMinutes": 6
}
