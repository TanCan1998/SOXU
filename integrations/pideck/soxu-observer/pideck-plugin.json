{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "soxu.observer",
  "name": "SOXU Observer",
  "version": "0.1.0",
  "description": "Read-only SOXU Agent Loop checkpoint monitor. Does not control Pi or read chat contents.",
  "permissions": [
    "network.local"
  ],
  "network": {
    "localPorts": [
      47321
    ]
  },
  "contributes": {
    "panels": [
      {
        "id": "main",
        "title": "SOXU 任务观测",
        "entry": "app.html",
        "presentation": "page"
      }
    ],
    "commands": [
      {
        "id": "open",
        "title": "SOXU 任务观测",
        "panelId": "main"
      }
    ]
  }
}
