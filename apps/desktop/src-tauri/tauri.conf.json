{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOXU",
  "version": "0.1.0",
  "identifier": "dev.soxu.desktop",
  "build": {
    "beforeDevCommand": "pnpm icons:generate && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm icons:generate && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SOXU · 索序",
        "width": 1240,
        "height": 820,
        "minWidth": 850,
        "minHeight": 550,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
